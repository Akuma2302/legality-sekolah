# MongoDB connection string (MongoDB Atlas: Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/legality_sekolah?retryWrites=true&w=majority

# Any long random string — used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Your deployed Netlify frontend URL, e.g. https://legality-sekolah.netlify.app
FRONTEND_URL=http://localhost:5173

PORT=4000

# Telegram bot integration for the Template Form Program Sekolah submit button.
# Optional — submissions still save without these, but won't be sent to Telegram
# until all three are filled in. See DEPLOYMENT.md for how to get these values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID_1=
TELEGRAM_TOPIC_ID_2=
